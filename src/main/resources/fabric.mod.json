{
  "schemaVersion": 1,
  "id": "shooting_star_addition",
  "version": "${version}",
  "name": "The Shooting Star Addition",
  "description": "An unofficial addon for The Shooting Star. Adds SS-05 Halley to the Stellar Remote: a comet called down onto your crosshair. It comes in low over the horizon, ploughs a frozen trench toward your mark and detonates on it, leaving an icy crater with the comet's glowing heart standing in it. Made for The Shooting Star 1.3.1 on Fabric 26.3.",
  "authors": [
    "adamko_10"
  ],
  "contact": {
    "sources": "https://github.com/Adamko-10/the-shooting-star-addition",
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/the-shooting-star-addition"
  },
  "license": "All-Rights-Reserved",
  "icon": "shooting_star_addition_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.ss05.halley.HalleyAddon"
    ],
    "client": [
      "dev.ss05.halley.client.HalleyClient"
    ]
  },
  "mixins": [
    {
      "config": "shooting_star_addition.mixins.json",
      "environment": "client"
    },
    {
      "config": "shooting_star_addition.compat.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "${shooting_star_mod_id}": "${shooting_star_version_range}"
  }
}
